import Lean

/-!
Every name of the `Collide` modules must resolve to the module that stock Lean resolves it to, both
through `Environment.getModuleIdxFor?` and through `Environment.const2ModIdx`. Stock `finalizeImport`
built `const2ModIdx` by visiting the imported modules in order, inserting each module's constants and
then its compiler-generated names (`extraConstNames`), and keeping the first insertion of each name.
-/

open Lean

/--
Stock Lean's `const2ModIdx` for the modules `data`, given in module order. Compiler-generated names
are read from each module's main data, which is where `finalizeImport` reads them from for modules
outside the module system, such as the `Collide` modules.
-/
def stockConst2ModIdx (data : Array ModuleData) : Std.HashMap Name ModuleIdx :=
  data.zipIdx.foldl (init := {}) fun m (d, i) =>
    let m := d.constNames.foldl (·.insertIfNew · i) m
    d.extraConstNames.foldl (·.insertIfNew · i) m

/--
Checks the names of the `Collide` modules in the import closure of `mod`, printing the result.
Returns whether they all resolve as in stock Lean.
-/
unsafe def checkCase (mod : Name) : IO Bool :=
  withImportModules #[{ module := mod }] {} fun env => do
    let data := env.header.moduleData
    let modNames := env.header.moduleNames
    let stock := stockConst2ModIdx data
    let caseMods := (List.range data.size).filter fun i => (`Collide).isPrefixOf modNames[i]!
    -- The case must import a kernel constant and an equal compiler-generated name from different
    -- modules, or it checks nothing.
    let mut shared := #[]
    for i in caseMods do
      for n in data[i]!.extraConstNames do
        for j in caseMods do
          if j != i && data[j]!.constNames.contains n then
            shared := shared.push s!"{n} is a constant of {modNames[j]!} and generated by {modNames[i]!}"
    if shared.isEmpty then
      IO.println s!"{mod}: no constant shares its name with another module's generated name"
      return false
    let modName? (idx? : Option ModuleIdx) := idx?.map (modNames[·]!)
    let mut checked : NameSet := {}
    let mut mismatches := #[]
    for i in caseMods do
      for n in data[i]!.constNames ++ data[i]!.extraConstNames do
        if checked.contains n then continue
        checked := checked.insert n
        let expected := modName? stock[n]?
        let viaGetModuleIdxFor := modName? (env.getModuleIdxFor? n)
        let viaConst2ModIdx := modName? env.const2ModIdx[n]?
        unless viaGetModuleIdxFor == expected && viaConst2ModIdx == expected do
          mismatches := mismatches.push
            s!"{n}: getModuleIdxFor? {viaGetModuleIdxFor}, const2ModIdx {viaConst2ModIdx}, stock {expected}"
    unless mismatches.isEmpty do
      IO.println s!"{mod}: names resolve differently from stock Lean:\n{"\n".intercalate mismatches.toList}"
      return false
    IO.println s!"{mod}: {checked.toList.length} names resolve as in stock Lean; {"; ".intercalate shared.toList}"
    return true

#eval show IO Unit from do
  let mut ok := true
  for mod in [`Collide.First, `Collide.Rev, `Collide.After, `Collide.Ir] do
    ok := (← unsafe checkCase mod) && ok
  unless ok do
    throw <| IO.userError "some names resolve differently from stock Lean"
