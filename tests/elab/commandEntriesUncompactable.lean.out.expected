lean #[-o, ST.olean, --usage=ST.usage, ST.lean]: exit 0
command 0: refusals #[a change to the command state's scopes], caches #[]
command 1: refusals #[entries for Lean.storedTracesExt that no .olean can store (a closure)], caches #[Lean.closedTermCacheExt, Lean.Compiler.LCNF.baseTypeExt, Lean.Compiler.LCNF.impureExt, Lean.Compiler.LCNF.declOrderExt, Lean.Compiler.LCNF.simpleGroundDeclExt]
command 2: refusals #[], caches #[]
command 3: refusals #[], caches #[]
noreuse (some true), reason (some (declaration command 1: entries for Lean.storedTracesExt that no .olean can store (a closure)))
